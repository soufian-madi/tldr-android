<?xml version="1.0" encoding="utf-8"?>
<!--
  A — semicolon — adaptive-icon foreground layer for TL;DR.

  The app's own punctuation, monolithic. The mark is the joke.

  Drawn in the 108x108 adaptive viewport: only the central 72x72 is ever visible
  and only the r=33 circle around (54,54) is mask-safe, so the mark is centred and
  scaled to stay inside that circle on round, squircle and teardrop masks alike.
  White fill on purpose — the same layer is reused as the <monochrome> layer, where
  the system supplies its own tint and only shape and alpha survive.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54.25"
        android:pivotY="55.85"
        android:scaleX="1.0"
        android:scaleY="1.0"
        android:translateX="-0.25"
        android:translateY="-1.85">

        <!-- upper dot -->
        <path
            android:pathData="M43,36 a11,11 0 1,1 22,0 a11,11 0 1,1 -22,0 Z"
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd" />
        <!-- comma bowl -->
        <path
            android:pathData="M43,64 a11,11 0 1,1 22,0 a11,11 0 1,1 -22,0 Z"
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd" />
        <!-- comma tail -->
        <path
            android:pathData="M63.5,68 C63,77 56.5,83.5 48,86 C45.6,86.7 44.4,83.3 46.6,82.2 C52,79.5 54.2,74.5 53.5,69 Z"
            android:fillColor="#FFFFFF"
            android:fillType="evenOdd" />

    </group>

</vector>
