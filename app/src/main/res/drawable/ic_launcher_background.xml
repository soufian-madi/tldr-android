<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: "ink", the app's own near-black. A barely-there
  vertical lift keeps the 108x108 field from reading as a dead flat rectangle
  once a launcher drops a shadow on it. No hue, by the same rule as the UI:
  the only colour in this product is the clickbait verdict.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="0"
                android:endY="108"
                android:startColor="#16191E"
                android:endColor="#0A0B0D" />
        </aapt:attr>
    </path>

</vector>
